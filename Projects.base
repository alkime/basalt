filters:
  and:
    - file.folder == "Projects"
formulas:
  tasks: file.backlinks.filter(if(value.asFile().properties.project, value.asFile().properties.project.asFile().path == file.path, false))
  total_tasks: formula.tasks.length
  done_tasks: formula.tasks.filter(value.asFile().properties.status == "Done" || value.asFile().properties.status == "Finished").length
  open_tasks: formula.tasks.filter(value.asFile().properties.status != "Done" && value.asFile().properties.status != "Finished" && value.asFile().properties.status != "Cancelled").length
  progress: if(formula.total_tasks > 0, (formula.done_tasks / formula.total_tasks * 100).round(1), "")
properties:
  file.name:
    displayName: Project
  note.status:
    displayName: Status
  formula.progress:
    displayName: Progress %
  formula.done_tasks:
    displayName: Done
  formula.total_tasks:
    displayName: Total
  formula.open_tasks:
    displayName: Open
  formula.tasks:
    displayName: Tasks
  note.latest:
    displayName: Latest
  note.summary:
    displayName: Summary
views:
  - type: table
    name: Active
    filters:
      or:
        - status == "In progress"
        - status == "Ongoing"
    order:
      - file.name
      - status
      - formula.progress
      - formula.done_tasks
      - formula.total_tasks
      - formula.open_tasks
      - latest
    sort:
      - property: formula.open_tasks
        direction: DESC
      - property: file.name
        direction: ASC
    summaries:
      formula.done_tasks: Sum
      formula.total_tasks: Sum
      formula.open_tasks: Sum
    columnSize:
      file.name: 320
      note.latest: 480
  - type: table
    name: Active - Compact
    filters:
      or:
        - status == "In progress"
        - status == "Ongoing"
    order:
      - file.name
      - status
    sort:
      - property: status
        direction: ASC
      - property: formula.open_tasks
        direction: DESC
    columnSize:
      file.name: 320
  - type: table
    name: All
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - formula.progress
      - formula.done_tasks
      - formula.total_tasks
      - formula.open_tasks
      - formula.tasks
    sort:
      - property: file.name
        direction: ASC
    summaries:
      formula.done_tasks: Sum
      formula.total_tasks: Sum
      formula.open_tasks: Sum
    columnSize:
      file.name: 320
